import QtQuick 2.4
import QtQuick.Layouts 1.1
import QtQuick.Controls 1.3

<script>
var curVal = 0;
var memory = 0;
var lastOp = "";
var timer = 0; // timer seems unused, but will keep for now.
var numpadModel = ["7", "8", "9", "4", "5", "6", "1", "2", "3", "0", ".", "="];

function disabled(op) {
    if (op === "." && curNum.text.toString().includes(".")) {
        return true;
    }
    if (op === "Sqrt" && curNum.text.toString().startsWith("-")) {
        return true;
    }
    // Add other disable conditions if necessary, e.g. division by zero for 1/x
    if (op === "1/x" && Number(curNum.text.valueOf()) === 0) {
        return true;
    }
    if (op === "/" && Number(curNum.text.valueOf()) === 0 && currentOperation.text === "/") { // Avoid double division by zero
        return true;
    }
    return false;
}

function executePendingOperation() {
    if (currentOperation.text === "") return;

    let val1 = Number(curVal);
    let val2 = Number(curNum.text.valueOf());
    let result = val2; // Default to val2 if no operation matches (e.g. after pressing '=')

    switch (currentOperation.text) {
        case "+":
            result = val1 + val2;
            break;
        case "-":
            result = val1 - val2;
            break;
        case "x":
            result = val1 * val2;
            break;
        case "/":
            if (val2 === 0) {
                curNum.text = "Error"; // Or some other error indication
                // Reset state?
                currentOperation.text = "";
                lastOp = "Error";
                return false; // Indicate error
            }
            result = val1 / val2;
            break;
        case "x^y":
            result = Math.pow(val1, val2);
            break;
    }
    curNum.text = result.toString().slice(0, 14); // Limit result length
    return true; // Indicate success
}

function doOp(op) {
    if (disabled(op)) {
        console.log("Operation " + op + " disabled.");
        return;
    }

    console.log("Op: " + op + ", LastOp: " + lastOp + ", CurVal: " + curVal + ", CurNum: " + curNum.text + ", PendOp: " + currentOperation.text);

    // Check if op is a number or decimal point
    if ((op >= "0" && op <= "9") || op === ".") {
        if (curNum.text.toString().length >= 14 && lastOp !== "+" && lastOp !== "-" && lastOp !== "x" && lastOp !== "/" && lastOp !== "x^y" && lastOp !== "=" && lastOp !== "AC" && lastOp !== "C") {
             // Allow new number input after an operator or equals/clear, even if length is maxed by previous result
            return;
        }
        // If last op was an operator, equals, or clear, start new number
        if (lastOp === "+" || lastOp === "-" || lastOp === "x" || lastOp === "/" || lastOp === "x^y" || lastOp === "=" || lastOp === "AC" || lastOp === "C" || lastOp === "MR" || lastOp === "Sqrt" || lastOp === "1/x" || lastOp === "^2" || lastOp === "Abs" || lastOp === "Int" || lastOp === "Sin" || lastOp === "Cos" || lastOp === "Tan" || lastOp === "Log" || lastOp === "e^x") {
            curNum.text = op;
        } else { // Append to current number
            curNum.text = curNum.text + op.toString();
        }
        lastOp = op; // Store the digit itself to check for multi-digit numbers
        return; // Return early for number inputs
    }

    // For any non-digit operation, first try to execute pending
    // But not if the current op is C or AC or Bksp or memory ops
    if (op !== "C" && op !== "AC" && op !== "Bksp" && op !== "MC" && op !== "MR" && op !== "MS" && op !== "M+" && op !== "+/-" && currentOperation.text !== "" && (lastOp >= "0" && lastOp <= "9" || lastOp === "." || lastOp === "MR")) {
      // Only execute if the last input was a number or memory recall
      if (!executePendingOperation()) return; // Stop if pending op resulted in error
    }


    switch (op) {
        // Pending Operations
        case "+":
        case "-":
        case "x":
        case "/":
        case "x^y":
            curVal = Number(curNum.text.valueOf());
            currentOperation.text = op;
            break;
        case "=":
            // executePendingOperation already called if needed
            if (currentOperation.text !== "") { // Ensure there was an operation
                 if (!executePendingOperation()) return; // Stop if error
            }
            currentOperation.text = "";
            curVal = Number(curNum.text.valueOf()); // Store result in curVal for potential chained ops like 2+3= = =
            break;

        // Immediate Operations
        case "1/x":
            curNum.text = (1 / Number(curNum.text.valueOf())).toString().slice(0,14);
            break;
        case "^2":
            curNum.text = (Number(curNum.text.valueOf()) * Number(curNum.text.valueOf())).toString().slice(0,14);
            break;
        case "Abs":
            curNum.text = (Math.abs(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "Sin":
            curNum.text = (Math.sin(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "Cos":
            curNum.text = (Math.cos(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "Tan":
            curNum.text = (Math.tan(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "Log": // Assuming base 10 log, Math.log is natural log
            curNum.text = (Math.log10(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "e^x":
            curNum.text = (Math.exp(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "Int":
            curNum.text = (Math.floor(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;
        case "+/-":
            curNum.text = (Number(curNum.text.valueOf()) * -1).toString();
            break;
        case "Sqrt":
            curNum.text = (Math.sqrt(Number(curNum.text.valueOf()))).toString().slice(0,14);
            break;

        // Memory Operations
        case "MC":
            memory = 0;
            break;
        case "M+":
            memory += Number(curNum.text.valueOf());
            break;
        case "MR":
            curNum.text = memory.toString().slice(0,14);
            break;
        case "MS":
            memory = Number(curNum.text.valueOf());
            break;

        // Control Operations
        case "Bksp":
            if (curNum.text.toString() === "Error" || (lastOp !== "." && !(lastOp >= "0" && lastOp <= "9"))) {
                // if error, or last op was not a number/decimal, C behavior
                // curNum.text = "0"; // Let C handle this if that's the desired behavior
            } else {
                 curNum.text = curNum.text.toString().slice(0, -1);
                 if (curNum.text.length === 0 || curNum.text === "-") {
                    curNum.text = "0";
                 }
            }
            break;
        case "C": // Clear current entry
            curNum.text = "0";
            // currentOperation and curVal remain for multi-step calculation
            break;
        case "AC": // All Clear
            curVal = 0;
            memory = 0;
            currentOperation.text = "";
            curNum.text = "0";
            break;
    }
    lastOp = op; // Update lastOp for all non-numeric operations too
    console.log("After Op: " + op + ", LastOp: " + lastOp + ", CurVal: " + curVal + ", CurNum: " + curNum.text + ", PendOp: " + currentOperation.text);
}
</script>

component MyCalcButton {
    Rectangle {
        property alias operation: label.text
        property bool toggable: false
        property bool toggled: false
        signal clicked
        id: calcButton
        width: 80
        height: 60
        color: "black"
        BorderImage {
            id: img
            width: parent.width
            height: parent.height
            border.left: 14
            border.right: 14
            source:"Button_h.png"
            transformOrigin: Item.Center
        }

        BorderImage {
            id: bgimg
            width: parent.width
            height: parent.height
            border.left: 14
            border.right: 14
            source:"Button.png"
        }
        Text { id: label; anchors.centerIn: parent; color: palette.buttonText } // palette.buttonText will be resolved from the parent (calculator.qml's palette)
        MouseArea {
            id: clickRegion
            anchors.fill: parent
            onClicked: {
                doOp(operation); // This now calls the function in calculator.qml's script block
                calcButton.clicked();
                if (!calcButton.toggable) return;
                calcButton.toggled ? calcButton.toggled = false : calcButton.toggled = true
            }
        }
        states: [
            State {
                name: "Pressed"; when: clickRegion.pressed == true
                PropertyChanges { target: img; scale: 2.0 }
                PropertyChanges { target: calcButton; z: 1 }
                PropertyChanges { target: calcButton.parent; z: 1 }
                PropertyChanges { target: calcButton.parent.parent; z: 1 }
                PropertyChanges { target: img; z: 1.1 }
                PropertyChanges { target: img; opacity: 0 }
            }
        ]
        transitions: Transition {
            NumberAnimation { property: "z,scale"; easing.type: Easing.OutExpo; duration: 200 }
            NumberAnimation { property: "opacity"; easing.type: Easing.InOutQuad; duration: 300 }
        }
    }
}

 Rectangle {
    width: parent.width
    height: 480
    color: palette.window
    anchors.fill: parent
    SystemPalette {
        id: palette
    }
    Column {
        x: 2; spacing: 2;
        Row {
          id: numericOperations
          spacing: 2
          Rectangle {
              id: container
              width: 400; height: 55
              border.color: palette.dark; color: palette.base

              Text {
                  id: curNum
                  font.bold: true; font.pointSize: 22
                  color: palette.text
                  anchors.right: container.right
                  anchors.rightMargin: 5
                  anchors.verticalCenter: container.verticalCenter
              }

              Text {
                  id: currentOperation
                  color: palette.text
                  font.bold: true; font.pointSize: 26
                  anchors.left: container.left
                  anchors.leftMargin: 5
                  anchors.verticalCenter: container.verticalCenter
              }
          }
          MyCalcButton {
              visible: advancedCheckBox.toggled == true
              operation: "Bksp";
              id: bksp;
          }
        }
        Item {
            height:460; width: 420;
            Item {
                id: basicButtons
                x: advancedCheckBox.toggled == true ? 0 : 55
                width: 460; height: 400
                Row {
                    id: commonOperations
                    spacing: 0
                    height: 150
                    MyCalcButton {
                        operation: "Advanced"
                        id: advancedCheckBox
                        width: 160
                        toggable: true
                    }
                    MyCalcButton { operation: "C"; id: c; }
                    MyCalcButton { operation: "AC"; id: ac;}
                }
                Grid {
                    id: numKeypad; y:60; spacing: 0; columns: 3
                    Repeater {
                        model: numpadModel
                        delegate: MyCalcButton {
                            operation: modelData
                        }
                    }
                }
                Column {
                    id: simpleOperations
                    x: 240;  y: 60; spacing: 0
                    MyCalcButton { operation: "x" }
                    MyCalcButton { operation: "/" }
                    MyCalcButton { operation: "-" }
                    MyCalcButton { operation: "+" }
                }
            }
            Grid {
	            visible: advancedCheckBox.toggled == true
                id: advancedButtons
                x: 320; y: 0; spacing: 0; columns: 2
                MyCalcButton { operation: "Abs" }
                MyCalcButton { operation: "Int" }
                MyCalcButton { operation: "MC" }
                MyCalcButton { operation: "Sqrt" }
                MyCalcButton { operation: "MR" }
                MyCalcButton { operation: "^2" }
                MyCalcButton { operation: "MS" }
                MyCalcButton { operation: "1/x" }
                MyCalcButton { operation: "M+" }
                MyCalcButton { operation: "+/-" }
            }
            Row {
              visible: advancedCheckBox.toggled == true
              id: trigonometryOperations
              spacing: 0; y: 300; x:0
              MyCalcButton { operation: "Sin" }
              MyCalcButton { operation: "Cos" }
              MyCalcButton { operation: "Tan" }
              MyCalcButton { operation: "Log" }
              MyCalcButton { operation: "e^x" }
              MyCalcButton { operation: "x^y" }
            }
        }
    }

    transitions: Transition {
        NumberAnimation { property: "x,y,width"; easing.type: Easing.OutBounce; duration: 500 }
        NumberAnimation { property: "opacity"; easing.type: Easing.InOutQuad; duration: 500 }
    }
 }
